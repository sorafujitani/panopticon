#!/bin/sh
set -eu

umask 077

SOURCE=$0
case "$SOURCE" in
  */*) ;;
  *) SOURCE=$(command -v -- "$SOURCE") ;;
esac
while [ -L "$SOURCE" ]; do
  LINK=$(readlink "$SOURCE")
  case "$LINK" in
    /*) SOURCE=$LINK ;;
    *) SOURCE=$(dirname "$SOURCE")/$LINK ;;
  esac
done
SCRIPT_DIR=$(
  unset CDPATH
  cd -- "$(dirname -- "$SOURCE")" && pwd -P
)
ROOT_DIR=$(
  unset CDPATH
  cd -- "$SCRIPT_DIR/.." && pwd -P
)
BINARY="$ROOT_DIR/.panopticon-bin"

needs_build=false
if [ ! -x "$BINARY" ]; then
  needs_build=true
else
  for build_input in go.mod go.sum; do
    if [ "$ROOT_DIR/$build_input" -nt "$BINARY" ]; then
      needs_build=true
      break
    fi
  done
fi
if [ "$needs_build" = false ]; then
  # バイナリに埋め込まれるのは internal/panopticon/assets 配下のため cmd/internal のみ走査する。
  for source_dir in cmd internal; do
    if [ -d "$ROOT_DIR/$source_dir" ] && find "$ROOT_DIR/$source_dir" -type f -newer "$BINARY" -print -quit | grep -q .; then
      needs_build=true
      break
    fi
  done
fi

if [ "$needs_build" = true ]; then
  temporary="$ROOT_DIR/.panopticon-bin.$$"
  trap 'rm -f "$temporary"' EXIT HUP INT TERM
  (
    unset CDPATH
    cd -- "$ROOT_DIR"
    go build -o "$temporary" ./cmd/panopticon
  )
  chmod 0700 "$temporary"
  mv -f -- "$temporary" "$BINARY"
  trap - EXIT HUP INT TERM
fi

export PANOPTICON_ROOT=${PANOPTICON_ROOT:-$ROOT_DIR}
exec "$BINARY" "$@"
